# AI 伴侣系统 — 环境变量示例（复制为 .env 后填写，.env 不入库）
# 说明：所有变量前缀都是 AI_COMPANION_；不要提交真实密钥。

# 运行环境：dev | test | prod
AI_COMPANION_ENV=dev
AI_COMPANION_LOG_LEVEL=INFO

# 数据库与缓存
AI_COMPANION_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/companion
AI_COMPANION_REDIS_URL=redis://localhost:6379/0

# 供应商密钥加密用主密钥：32 字节随机数的 base64。
# 生成方式（PowerShell 7）：
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
AI_COMPANION_MASTER_KEY=

# DeepSeek 官方 API Key（默认模型 deepseek-flash）
AI_COMPANION_DEEPSEEK_API_KEY=

# 其他可选供应商（不填则该供应商不可用）
AI_COMPANION_QWEN_API_KEY=
AI_COMPANION_KIMI_API_KEY=
AI_COMPANION_GLM_API_KEY=
AI_COMPANION_SILICONFLOW_API_KEY=
AI_COMPANION_OPENAI_API_KEY=

# 本地模型（Ollama / LM Studio / vLLM）默认端口写在 presets.yaml 里
# 单机自用可打开；公网多用户部署务必保持 false
AI_COMPANION_ALLOW_PRIVATE_MODEL_ENDPOINTS=false

# 开发期鉴权占位：生产必须关闭
# 开发模式登录：生产必须 false；本地使用请保持 false，先登录再使用
AI_COMPANION_DEBUG_AUTH=false
# 开发模式把短信验证码直接返回（不真的发短信）
AI_COMPANION_SMS_DEBUG=true
AI_COMPANION_DEBUG_USER_ID=dev-user

# 管理员手机号（逗号分隔），登录时自动授予 admin 角色
AI_COMPANION_ADMIN_PHONES=

# 成本与上下文预算（命中率默认 0.75：2026-10-25 实测短前缀仅 52%）
AI_COMPANION_DEFAULT_HIT_RATIO=0.75
# 每日对话/演练轮次上限（免费额度）
AI_COMPANION_DAILY_TURN_LIMIT=60
AI_COMPANION_TURN_COST_CAP_CNY=0.02
AI_COMPANION_EXPECTED_OUTPUT_TOKENS=500
AI_COMPANION_MAX_CONTEXT_RATIO=0.8

# ---------- 本地单用户模式（开源默认） ----------
# true：免登录，不需要账号与管理员，所有数据归本机
# false：恢复多用户 + 手机验证码登录（需要配置短信服务）
AI_COMPANION_LOCAL_MODE=true
AI_COMPANION_LOCAL_USER_ID=local-user

# ---------- 多端访问（桌面 + 手机/PWA） ----------
# 是否监听局域网：true=0.0.0.0（手机可访问），false=仅本机
AI_COMPANION_LISTEN_LAN=false
# 允许跨端访问的前端来源（逗号分隔）；留空=只允许同源
# 例：AI_COMPANION_CORS_ORIGINS=http://192.168.1.10:8000
AI_COMPANION_CORS_ORIGINS=

# ---------- 语音 ----------
# 语音音频临时目录；留空则用系统临时目录
AI_COMPANION_AUDIO_DIR=

# ---------- 前端构建产物 ----------
# 留空则用仓库下的 frontend/dist（由后端直接托管页面）
AI_COMPANION_FRONTEND_DIST=
